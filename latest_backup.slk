(1,'General Message','USMAN STUDY POINT','MiniAcademy'),
(2,'Reminder','Usman Study Point Dear <<name>> Your balance of Rs.<<amount>> is still payable,please pay it as soon as possible','Fee'),
(3,'Welcome','Dear <<name>>.You are registered in Usman Study Point.Your Student ID is <<code>>.Well Come to our institute.A good place for your educational needs.','Student'),
(4,'Promotion','Usman Study Point Dear <<name>> you are promoted to Next class.We wish you Gud luck.','Student'),
(5,'Newfee','Usman Study Point Dear student  <<name>> Your fee of Rs.<<amount>> is still payable,Plz pay it before due date. Thanks.','Fee'),
(6,'absentee','Usman Study Point.Dear parents your child is absent from academy today.Plz contact to class incharge soon. Thanks','Attendance'),
(7,'Result','Usman Study Point  <<name>> <<result>> <<sresult>>','examination'),
(8,'staff','staff message','payroll'),
(9,'Header','','Yes'),
(10,'Footer','','Yes');
/*!40000 ALTER TABLE `smsmsg` ENABLE KEYS */;
