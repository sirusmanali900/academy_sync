--
-- Table structure for table `resultmaster`
--

DROP TABLE IF EXISTS `resultmaster`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `resultmaster` (
  `resultmasterid` int(10) NOT NULL AUTO_INCREMENT,
  `clasid` int(30) NOT NULL,
  `section` varchar(10) NOT NULL,
  `sesionid` int(5) NOT NULL,
  `subjectid` int(20) NOT NULL,
  `part` int(10) NOT NULL,
  `esdate` date NOT NULL,
  `etype` varchar(20) NOT NULL,
  `tmarks` int(5) NOT NULL,
  `teacher` varchar(255) NOT NULL,
  `edate` date NOT NULL,
  `timeallowed` varchar(20) NOT NULL,
  `pmarks` int(5) NOT NULL,
  PRIMARY KEY (`resultmasterid`)
) ENGINE=MyISAM AUTO_INCREMENT=9823 DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

