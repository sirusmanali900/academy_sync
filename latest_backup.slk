  `clasid` int(30) NOT NULL,
  `section` varchar(10) NOT NULL,
  `sesionid` int(5) NOT NULL,
  `subjectid` int(20) NOT NULL,
  `part` int(10) NOT NULL,
  `adate` date NOT NULL,
  `day` varchar(20) NOT NULL,
  PRIMARY KEY (`attendancemasterid`)
) ENGINE=MyISAM AUTO_INCREMENT=7636 DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci;
