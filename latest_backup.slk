--
-- Table structure for table `installment`
--

DROP TABLE IF EXISTS `installment`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `installment` (
  `studentid` int(9) NOT NULL,
  `amount` int(12) DEFAULT NULL,
  `duedate` date DEFAULT NULL,
  `insno` int(10) DEFAULT NULL,
  `status` varchar(50) DEFAULT NULL,
  `pkno` int(10) DEFAULT NULL,
  `adjusted` int(10) DEFAULT NULL,
  `recdate` date DEFAULT NULL,
  `vocherno` int(20) DEFAULT NULL,
  `recamount` int(12) DEFAULT NULL,
  `installmentid` int(9) NOT NULL AUTO_INCREMENT,
  `pktype` int(10) NOT NULL,
  `admission` int(10) NOT NULL,
  `tution` int(10) NOT NULL,
  `misc` int(10) NOT NULL,
  `scholo` int(10) NOT NULL,
  `discount` int(10) NOT NULL,
  `otherfee` int(10) NOT NULL,
  `form` int(10) NOT NULL,
  `nmonths` int(10) NOT NULL,
  `smonths` varchar(20) NOT NULL,
  `cdiscount` int(10) NOT NULL,
  `pdescription` varchar(100) NOT NULL,
  `pmode` varchar(10) NOT NULL,
  `idescription` varchar(100) NOT NULL,
  `oamount` int(10) NOT NULL,
  `fine` int(20) NOT NULL,
  `library` int(20) NOT NULL,
  `books` int(20) NOT NULL,
  `uniform` int(20) NOT NULL,
  `otherfine` int(20) NOT NULL,
  `fdiscount` int(20) NOT NULL,
  `posted` varchar(20) NOT NULL,
  `odfine` int(20) NOT NULL,
  `arrears` int(10) NOT NULL,
  PRIMARY KEY (`installmentid`)
) ENGINE=MyISAM AUTO_INCREMENT=20670 DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

