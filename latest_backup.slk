--
-- Table structure for table `student`
--

DROP TABLE IF EXISTS `student`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `student` (
  `studentid` int(9) NOT NULL AUTO_INCREMENT,
  `family` int(10) NOT NULL,
  `admissiondate` date DEFAULT NULL,
  `fname` varchar(100) DEFAULT NULL,
  `lname` varchar(100) DEFAULT NULL,
  `dob` date DEFAULT NULL,
  `gender` varchar(20) DEFAULT NULL,
  `nic` varchar(25) DEFAULT NULL,
  `address` varchar(100) DEFAULT NULL,
  `town` varchar(100) DEFAULT NULL,
  `city` varchar(100) DEFAULT NULL,
  `email` varchar(100) DEFAULT NULL,
  `phone` varchar(100) DEFAULT NULL,
  `mobile` varchar(100) DEFAULT NULL,
  `mobile2` varchar(100) DEFAULT NULL,
  `fathername` varchar(100) DEFAULT NULL,
  `fphone` varchar(100) DEFAULT NULL,
  `foccupation` varchar(100) DEFAULT NULL,
  `fnic` varchar(25) DEFAULT NULL,
  `InstituteID` int(10) DEFAULT NULL,
  `lastqualification` int(10) DEFAULT NULL,
  `passingyear` varchar(100) DEFAULT NULL,
  `followdate` date DEFAULT NULL,
  `tmarks` varchar(100) DEFAULT NULL,
  `omarks` varchar(100) DEFAULT NULL,
  `referby` varchar(100) DEFAULT NULL,
  `councilor` varchar(100) DEFAULT NULL,
  `remarks` varchar(100) DEFAULT NULL,
  `formno` varchar(20) DEFAULT NULL,
  `orefer` varchar(100) DEFAULT NULL,
  `degree` int(10) DEFAULT NULL,
  `part` int(10) DEFAULT NULL,
  `admbase` varchar(100) DEFAULT NULL,
  `board` int(9) DEFAULT NULL,
  `lcroll` varchar(100) DEFAULT NULL,
  `regno` varchar(100) DEFAULT NULL,
  `status` varchar(100) DEFAULT NULL,
  `imagedata` mediumblob NOT NULL,
  `imagetype` varchar(20) DEFAULT NULL,
  `nationality` varchar(50) DEFAULT NULL,
  `religion` varchar(20) DEFAULT NULL,
  `mediam` varchar(10) DEFAULT NULL,
  `regno2` varchar(100) NOT NULL,
  `image` varchar(250) NOT NULL,
  PRIMARY KEY (`studentid`),
  UNIQUE KEY `formno` (`formno`)
) ENGINE=MyISAM AUTO_INCREMENT=1321 DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

--
